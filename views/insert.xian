{{> head}}
<body class="bg-gray-100"><div class="container mx-auto px-4 py-8"><h1 class="text-3xl font-bold text-center mb-2">Library / Book Catalog</h1><p class="text-center text-gray-600 mb-8">Manage books, authors, genres, borrowing, returns, and inventory.</p><h2 class="text-xl font-bold text-center mb-4">Add a Book</h2><form method="POST" action="/books"><table class="border-collapse border border-gray-300 bg-white mb-8 mx-auto w-full max-w-4xl text-sm"><tr><td class="border p-2">Book Title</td><td class="border p-2"><input class="border rounded p-2 w-full" name="title" required></td><td class="border p-2">Author</td><td class="border p-2"><input class="border rounded p-2 w-full" name="author" required></td></tr><tr><td class="border p-2">Genre</td><td class="border p-2"><input class="border rounded p-2 w-full" name="genre" required></td><td class="border p-2">ISBN</td><td class="border p-2"><input class="border rounded p-2 w-full" name="isbn"></td></tr><tr><td class="border p-2">Total Copies</td><td class="border p-2"><input class="border rounded p-2 w-full" type="number" name="totalCopies" min="0" value="1" required></td><td class="border p-2" colspan="2"><button class="bg-blue-600 text-white rounded px-4 py-2">Add Book</button></td></tr></table></form><h2 class="text-xl font-bold mb-4">Book Inventory</h2><div class="overflow-x-auto"><table class="border-collapse border border-gray-300 bg-white w-full text-sm"><thead><tr class="bg-gray-200"><th class="border p-2">Title</th><th class="border p-2">Author</th><th class="border p-2">Genre</th><th class="border p-2">ISBN</th><th class="border p-2">Available / Total</th><th class="border p-2">Status</th><th class="border p-2">Actions</th></tr></thead><tbody>{{#each books}}<tr><td class="border p-2">{{this.title}}</td><td class="border p-2">{{this.author}}</td><td class="border p-2">{{this.genre}}</td><td class="border p-2">{{this.isbn}}</td><td class="border p-2">{{this.availableCopies}} / {{this.totalCopies}}</td><td class="border p-2">{{#if this.availableCopies}}Available{{else}}All borrowed{{/if}}</td><td class="border p-2"><a class="text-blue-600 underline" href="/books/{{this.id}}">Edit</a><form class="inline" method="POST" action="/books/{{this.id}}/borrow"><button class="text-green-700 underline ml-2">Borrow</button></form><form class="inline" method="POST" action="/books/{{this.id}}/return"><button class="text-purple-700 underline ml-2">Return</button></form><form method="POST" action="/books/{{this.id}}/delete" onsubmit="return confirm('Delete this book?')"><button class="text-red-600 underline">Delete</button></form></td></tr>{{else}}<tr><td class="border p-4 text-center" colspan="7">No books added yet.</td></tr>{{/each}}</tbody></table></div></div></body>
{{> footer}}

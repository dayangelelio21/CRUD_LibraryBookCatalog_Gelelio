{{> head}}
<body class="bg-gray-50"><div class="container mx-auto px-4 py-8"><h1 class="text-2xl font-bold mb-6">Edit Book</h1><form method="POST" action="/books/{{book.id}}"><table class="w-full max-w-3xl border-collapse border bg-white"><tr><td class="border p-3">Title</td><td class="border p-3"><input class="border p-2 w-full" name="title" value="{{book.title}}" required></td></tr><tr><td class="border p-3">Author</td><td class="border p-3"><input class="border p-2 w-full" name="author" value="{{book.author}}" required></td></tr><tr><td class="border p-3">Genre</td><td class="border p-3"><input class="border p-2 w-full" name="genre" value="{{book.genre}}" required></td></tr><tr><td class="border p-3">ISBN</td><td class="border p-3"><input class="border p-2 w-full" name="isbn" value="{{book.isbn}}"></td></tr><tr><td class="border p-3">Total Copies</td><td class="border p-3"><input class="border p-2 w-full" type="number" min="0" name="totalCopies" value="{{book.totalCopies}}" required></td></tr><tr><td class="border p-3" colspan="2"><button class="bg-blue-600 text-white px-4 py-2">Update Book</button><a class="ml-2 text-blue-600 underline" href="/books">Cancel</a></td></tr></table></form></div></body>
{{> footer}}
